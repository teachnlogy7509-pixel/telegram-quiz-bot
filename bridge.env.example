# Separate Railway service: Start Command = python bridge_bot.py
BRIDGE_TELEGRAM_BOT_TOKEN=
BRIDGE_GROUP_CHAT_ID=-100xxxxxxxxxx
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
BRIDGE_ENABLED=true
BRIDGE_POLL_SECONDS=60
BRIDGE_SCORE_DELAY_MINUTES=30
BRIDGE_MOTIVATION_MINUTES=180

# Online AI: OpenRouter is tried first, then Gemini keys as fallback.
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_MODEL=openrouter/auto
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-2.5-flash

# If all providers or the network are unavailable, Sakhi uses local offline
# replies for basic help and motivation. No AI key is needed for that fallback.
